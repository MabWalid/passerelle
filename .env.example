PORT=3000
# Laisser vide pour la démo locale. Dès qu'une valeur est posée,
# créer une carte et enregistrer un ticket exigent Authorization: Bearer.
PASSE_API_KEY=
STORE_PATH=./data/passerelle.sqlite
# --- Apple Wallet (compte Apple Developer requis) ---
APPLE_PASS_TYPE_ID=pass.com.tonnom.fidelite
APPLE_TEAM_ID=ABCDE12345
APPLE_SIGNER_PASSPHRASE=
# URL https publique du serveur, avec / final, pour mettre à jour les passes déjà installés.
APPLE_WEB_SERVICE_URL=
# fichiers PEM à placer dans ./certs : wwdr.pem, signerCert.pem, signerKey.pem
# --- Google Wallet (compte de service requis) ---
GOOGLE_ISSUER_ID=3388000000000000000
GOOGLE_SA_FILE=./certs/google-service-account.json
# Image https que Google peut télécharger. Un logo en exemple.fr est refusé.
GOOGLE_LOGO_URL=
